{
  "manifest_version": 3,
  "name": "OTP Peek",
  "version": "1.2.0",
  "description": "Shows your newest Gmail OTP. Click to copy. No Gmail tab needed; nothing leaves your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OTP Peek"
  },
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://mail.google.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "otp-peek@govindarajue6data.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
