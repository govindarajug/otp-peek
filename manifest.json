{
  "manifest_version": 3,
  "name": "OTP Peek",
  "version": "1.3.0",
  "description": "Shows your newest Gmail OTP. Click or hotkey to copy. No Gmail tab needed; nothing leaves your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OTP Peek"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["extractor.js", "feed.js", "background.js"]
  },
  "commands": {
    "copy-latest-otp": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy the latest OTP to the clipboard"
    }
  },
  "permissions": ["clipboardWrite", "offscreen"],
  "host_permissions": ["https://mail.google.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "otp-peek@govindarajue6data.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
